  <!--
    Release-SFX-Free: the libc-free stub (x64 only). It is linked without the
    C/C++ runtime library and imports kernel32.dll only; src/platform/ provides
    the C functions it needs. The settings that make this possible:

    Compiler
      /MT                    the C library headers declare ordinary functions
                             (not DLL imports), so that the functions of
                             src/platform/ are used. Nothing is linked from the CRT.
      /GS- /sdl- /guard:cf-  no security checks: they need support code from the CRT
      /GR- /EHs-c-           no run-time type information, no exceptions
      /Zc:threadSafeInit-    no thread-safe initialization of local static
                             variables: it needs support code from the CRT
      /Gs1048576             no stack probes (calls to __chkstk, which is in the
                             CRT) for functions that use less than 1 MB of stack.
                             Safe, because the linker settings below commit the
                             whole 1 MB stack when the program starts.
    Linker
      /NODEFAULTLIB, kernel32.lib   link kernel32.dll only
      /ENTRY:sfx_entry       the program starts in Platform_Windows.cpp
      /STACK:1048576,1048576 1 MB of stack, committed at once (see /Gs)
      /FIXED /DYNAMICBASE:NO no relocation table (smaller; no ASLR for the stub)
      /MANIFEST:NO           no manifest; a console program does not need one

    CRuntime.cpp and Platform_Windows.cpp are compiled without whole program
    optimization (see the two files in the list at the end).
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release-SFX-Free|x64'">
